            "type": "string"
          },
          "deepgram_api_key": {
            "title": "Deepgram Api Key",
            "type": "string"
          },
          "embedding_method": {
            "title": "Embedding Method",
            "type": "string"
          },
          "openai_api_key": {
            "title": "Openai Api Key",
