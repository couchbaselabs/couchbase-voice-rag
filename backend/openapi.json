      "SettingsRequest": {
        "description": "Cluster + OpenAI settings submitted by the Settings UI.",
        "properties": {
          "azure_openai_endpoint": {
            "description": "Azure OpenAI resource URL (https://...).",
            "title": "Azure Openai Endpoint",
            "type": "string"
          },
          "capella_api_key_id": {
            "default": "",
            "description": "Capella Management API key ID (only when EMBEDDING_METHOD=capella).",
            "format": "password",
            "title": "Capella Api Key Id",
            "type": "string",
            "writeOnly": true
