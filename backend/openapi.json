          "capella_api_key_token": {
            "default": "",
            "description": "Capella Management API key token.",
            "format": "password",
            "title": "Capella Api Key Token",
            "type": "string",
            "writeOnly": true
          },
          "capella_workflow_name": {
            "default": "realtime_rag_vectorization",
            "description": "Capella AI Workflow name. Backend looks for an existing workflow with this name on the cluster and reuses it; creates one with this exact name if none exists.",
            "title": "Capella Workflow Name",
            "type": "string"
          },
          "cb_bucket": {
            "title": "Cb Bucket",
            "type": "string"
          },
          "cb_collection": {
            "description": "Collection name. UI auto-fills from ``embedding_method`` (documents_local / documents_capella) but the user can override.",
            "title": "Cb Collection",
            "type": "string"
          },
          "cb_connection_string": {
            "description": "``couchbases://...`` endpoint.",
            "title": "Cb Connection String",
            "type": "string"
          },
          "cb_password": {
            "format": "password",
            "title": "Cb Password",
            "type": "string",
            "writeOnly": true
          },
          "cb_scope": {
            "default": "_default",
            "title": "Cb Scope",
            "type": "string"
          },
          "cb_search_index": {
            "description": "Vector search index name. Auto-filled by UI based on mode.",
            "title": "Cb Search Index",
            "type": "string"
          },
          "cb_username": {
            "title": "Cb Username",
            "type": "string"
          },
          "deepgram_api_key": {
            "default": "",
            "description": "Deepgram primary STT API key (Whisper is the fallback when blank).",
            "format": "password",
            "title": "Deepgram Api Key",
            "type": "string",
            "writeOnly": true
          },
          "embedding_method": {
            "default": "capella",
            "description": "One of ``capella`` (AI Services workflow) or ``python`` (local).",
            "title": "Embedding Method",
            "type": "string"
          },
          "openai_api_key": {
            "description": "Azure OpenAI API key.",
            "format": "password",
            "title": "Openai Api Key",
            "type": "string",
            "writeOnly": true
          },
          "openai_embedding_model": {
            "description": "Azure OpenAI embedding deployment name.",
            "title": "Openai Embedding Model",
            "type": "string"
          },
          "openai_realtime_model": {
            "description": "Azure OpenAI Realtime deployment name.",
            "title": "Openai Realtime Model",
            "type": "string"
          },
          "tavily_api_key": {
            "default": "",
            "description": "Tavily key for the web-search fallback.",
            "format": "password",
            "title": "Tavily Api Key",
            "type": "string",
            "writeOnly": true
          },
          "web_search_enabled": {
            "default": false,
            "description": "Enable Tavily web-search fallback when KB has no relevant results.",
            "title": "Web Search Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "cb_connection_string",
          "cb_username",
          "cb_password",
          "cb_bucket",
          "cb_collection",
          "cb_search_index",
          "azure_openai_endpoint",
          "openai_api_key",
          "openai_realtime_model",
          "openai_embedding_model"
        ],
        "title": "SettingsRequest",
        "type": "object"
      },
      "SettingsResponse": {
        "description": "Envelope for :class:`SettingsValues`.",
