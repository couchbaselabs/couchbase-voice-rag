    "/api/settings": {
      "get": {
        "description": "Return stored settings, including secret fields.\n\nAuthenticated callers get the same view they'd see in any password\nmanager: the secret values are echoed so the UI can pre-fill inputs\nthat render as ``type=password`` (dot-masked), with an eye toggle\nrevealing plaintext on demand. The on-disk store stays\nFernet-encrypted regardless.",
        "operationId": "get_settings_api_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read stored Couchbase settings",
        "tags": [
          "settings"
        ]
      },
      "post": {
        "description": "Persist new connection settings, reconnect to Couchbase, and re-run index setup.\n\nIn Capella mode (and only when a Capella API key is configured), the\nDB user and bucket are auto-created via the Management API before the\nSDK connect attempt. The Docker scenario relies on\n``couchbase_service._init_docker_cluster`` to bootstrap services /\nquotas / admin \u2014 that's invoked from inside ``connect()``.",
        "operationId": "save_settings_api_settings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveSettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Save Couchbase settings and reconnect",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/settings/progress": {
      "get": {
        "description": "Return the stage of the most recent (or in-flight) Save & Connect.\n\nPolled by the Settings UI on ~0.5s intervals while the form is\nsubmitting so the button label can advance through \"applying\",\n\"connecting\", \"creating_collections\", \"building_search_index\", etc.\nThe POST /api/settings call itself only resolves at the end of the\nmulti-step setup, so without this endpoint the user has no\nindication of which step is currently running.",
        "operationId": "settings_progress_api_settings_progress_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsProgressResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Current Save & Connect progress stage",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/settings/status": {
      "get": {
        "description": "Return whether the server currently holds a live Couchbase connection.\n\nFalls back to the on-disk settings file if this worker's in-memory\n``cb_initialized`` flag is False. Multi-worker deployments only run\nlifespan-init once per process, so a request can land on a worker that\nmissed the original Save & Connect even though the cluster is fully\nset up. In that case we lazily apply the saved settings + reconnect on\nthe worker, mirroring what lifespan would have done.",
        "operationId": "settings_status_api_settings_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Check Couchbase connection status",
        "tags": [
          "settings"
        ]
      }
    }
