# ============================================================
# Couchbase Realtime Voice RAG — environment variables
# ============================================================
# These values are *defaults* surfaced in the Settings UI on first
# login. The backend never auto-connects with cluster or Azure OpenAI
# credentials from this file — you confirm / edit in the UI and click
# "Save & Connect", which is the moment the DB user, bucket, scope,
# collection, and search-index are created on the cluster.
#
# Whatever you put here reaches the backend container as-is — there is
# no `environment:` shadow in docker-compose. Override anything by
# editing this file directly.
#
# Secrets (Couchbase password, OpenAI API key, etc.) are stored
# Fernet-encrypted in data/db_settings.json after Save; the encryption
# key is derived from JWT_SECRET via HKDF-SHA256.

# --- Required ---

# App login (comma-separated "user:password" pairs)
APP_USERS=admin:admin

# JWT signing secret. Empty = auto-generated random per-process
# secret (warning logged; all tokens drop on restart). Set 32+ chars
# for stable sessions.
#
# This same value also derives (via HKDF-SHA256) the Fernet key
# that encrypts secrets persisted in backend/data/db_settings.json
# (Couchbase password, Azure OpenAI API key). Two practical
# consequences:
#   1. Empty / changing JWT_SECRET makes saved settings undecryptable
#      on the next start, so the Settings UI comes up blank again
#      even though backend/data/ is bind-mounted across restarts.
#   2. Rotating JWT_SECRET intentionally invalidates saved settings
#      -- that is the documented rotation path.
JWT_SECRET=

# --- Azure OpenAI (Settings UI pre-fills these) ---
# Realtime API + embeddings. Override the deployment names below
# only if your Azure deployment uses non-default names.
#
# IMPORTANT: AZURE_OPENAI_ENDPOINT is the *base resource URL* only —
# do not append `/openai/realtime?api-version=...&deployment=...` to
# it. The backend builds that path itself
# (see backend/services/realtime_service.py). Including the path
# yields a double-path URL and a 400 from Azure during voice chat
# WebSocket handshake.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
OPENAI_API_KEY=your-azure-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Cluster bring-up (Settings UI pre-fills these) ---
# Defaults below match the bundled docker-compose Couchbase. Change
# the connection string + embedding method when pointing the demo at
# a different cluster:
#   - Capella:     couchbases://cb.<id>.cloud.couchbase.com
#                  + EMBEDDING_METHOD=capella + CAPELLA_API_KEY_*
#   - Self-hosted: couchbase://your-host
#   - Manual dev:  couchbase://localhost
# CB_PASSWORD is left blank on purpose — type the cluster admin
# password into the Settings UI and click Save & Connect (no silent
# default).

CB_CONNECTION_STRING=couchbase://couchbase-server
CB_USERNAME=Administrator
CB_PASSWORD=
CB_BUCKET=realtime-rag
CB_SCOPE=_default
EMBEDDING_METHOD=python

# Optional explicit collection / search-index names. Leave blank
# and the Settings UI will derive them from EMBEDDING_METHOD
# (documents_local + vector-search-index-local for python,
# documents_capella + vector-search-index-capella for capella).
# CB_COLLECTION=
# CB_SEARCH_INDEX=

# --- Capella AI Services (only when EMBEDDING_METHOD=capella) ---
# When both are set, the demo auto-creates the DB user + bucket
# on Save & Connect via the Capella Management API.
CAPELLA_API_KEY_ID=
CAPELLA_API_KEY_TOKEN=

# Multi-tenant override (rare): only set if your API key spans
# several orgs / projects and auto-discovery picks the wrong one.
# CAPELLA_ORG_ID=
# CAPELLA_PROJECT_ID=
# CAPELLA_CLUSTER_ID=

# Capella AI Workflow name. Backend looks for a workflow with this
# exact name on the cluster and reuses it across runs; if no match
# exists it auto-creates one with this name. Override to pick a
# different name (e.g. to share a workflow between multiple demos
# under different prefixes); the in-code default already matches
# the value below.
# CAPELLA_WORKFLOW_NAME=realtime_rag_vectorization

# --- Optional integrations ---

# Deepgram (required for voice STT — without this key /ws/deepgram
# closes with code 4002 and voice mode is unavailable).
DEEPGRAM_API_KEY=

# Tavily web search (KB-miss fallback). When set, the Settings UI's
# "Web search fallback" toggle becomes effective; toggling it off
# stops the LLM from being offered the search_web tool even if a key
# is configured.
TAVILY_API_KEY=

# Default state for the web-search toggle. Settings UI overrides this on Save.
WEB_SEARCH_ENABLED=false

# --- Operational (Docker / production) ---

# Root JSON-log level: DEBUG / INFO / WARNING / ERROR.
# DEBUG turns on per-event traces from realtime_service (OpenAI send /
# OpenAI event / Client msg / Unhandled OpenAI event). Combine with
# REALTIME_DEBUG_PAYLOAD=1 to also include the event payload body.
# LOG_LEVEL=INFO

# Gunicorn (Dockerfile.backend) — tune worker count / timeouts.
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_KEEPALIVE=5
